---
layout: base.njk
pagination:
  data: transportByLang
  size: 1
  alias: item
permalink: "{% if item.lang == 'en' %}/en/transport/{{ item.vehicle.meta_title }}/{% else %}/transport/{{ item.vehicle.meta_title }}/{% endif %}"
eleventyComputed:
  lang: "{{ item.lang }}"
  title: "{% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}{{ transportTranslations[item.vehicle.meta_title][item.lang].title }}{% else %}{{ item.vehicle.title }}{% endif %}"
  description: "{{ item.vehicle.shortDescription or item.vehicle.short_description }}"
---

<section class="py-6">
    <div class="max-w-7xl w-full mx-auto px-4">
        <div class="mb-6 md:hidden">
            <h1 class="text-2xl text-center font-bold text-[#25425E]">
                {% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}
                    {{ transportTranslations[item.vehicle.meta_title][item.lang].title }}
                {% else %}
                    {{ item.vehicle.title }}
                {% endif %}
            </h1>
        </div>

        <div class="flex flex-col md:flex-row gap-8 md:gap-12">
            <!-- Image gallery -->
            <div class="w-full md:w-1/2 flex flex-col gap-4">
                {% if item.vehicle.images and item.vehicle.images.length > 0 %}
                    <div class="bg-white rounded-3xl shadow-lg overflow-hidden aspect-[4/3]">
                        <img id="vehicle-main-image" src="{{ item.vehicle.images[0] | url }}" alt="{% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}{{ transportTranslations[item.vehicle.meta_title][item.lang].title }}{% else %}{{ item.vehicle.title }}{% endif %}" class="w-full h-full object-cover transition-opacity duration-300"{% if item.vehicle.meta_title == 'toyota' or item.vehicle.slug == 'toyota' %} style="object-position: left center;"{% endif %}>
                    </div>

                    {% if item.vehicle.images.length > 1 %}
                        <div class="flex flex-wrap gap-3 justify-center">
                            {% for image in item.vehicle.images %}
                                {% if image %}
                                    <button class="vehicle-thumbnail flex-shrink-0 w-24 h-24 opacity-60 hover:opacity-100 rounded-2xl overflow-hidden transition-opacity cursor-pointer border border-white/20 shadow" data-image-src="{{ image | url }}">
                                        <img src="{{ image | url }}" alt="{% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}{{ transportTranslations[item.vehicle.meta_title][item.lang].title }}{% else %}{{ item.vehicle.title }}{% endif %} thumbnail {{ loop.index }}" class="w-full h-full object-cover">
                                    </button>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endif %}
            </div>

            <!-- Vehicle info -->
            <div class="w-full md:w-1/2 flex flex-col gap-6">
                <div class="hidden md:block">
                    <h1 class="text-3xl font-bold text-[#25425E]">
                        {% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}
                            {{ transportTranslations[item.vehicle.meta_title][item.lang].title }}
                        {% else %}
                            {{ item.vehicle.title }}
                        {% endif %}
                    </h1>
                </div>

                <p class="text-primary-deepsea text-base leading-relaxed">{{ item.vehicle.short_description }}</p>

                <div class="rounded-3xl bg-transparent border-2 border-dotted border-[#25425E]/30 px-6 py-4">
                    <div class="flex items-start gap-3">
                        <img src="{{ '/assets/images/gps.png' | url }}" alt="GPS tracking" class="w-5 h-5 flex-shrink-0 mt-0.5">
                        <p class="text-base text-[#25425E] leading-relaxed">{{ 'transportDetail.gpsText' | t(item.lang) }}</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {% if item.vehicle.temperature_range %}
                        <div class="rounded-xl border border-[#25425E]/15 bg-[#25425E]/5 px-4 py-3">
                            <p class="text-xs uppercase tracking-wide text-[#25425E]/80 font-semibold">{{ 'transport.temperature' | t(item.lang) }}</p>
                            <p class="text-base font-semibold text-[#25425E] mt-1">
                                {% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}
                                    {{ transportTranslations[item.vehicle.meta_title][item.lang].temperature_range }}
                                {% else %}
                                    {{ item.vehicle.temperature_range }}
                                {% endif %}
                            </p>
                        </div>
                    {% endif %}
                    {% if item.vehicle.capacity %}
                        <div class="rounded-xl border border-[#25425E]/15 bg-[#25425E]/5 px-4 py-3">
                            <p class="text-xs uppercase tracking-wide text-[#25425E]/80 font-semibold">{{ 'transport.capacity' | t(item.lang) }}</p>
                            <p class="text-base font-semibold text-[#25425E] mt-1">
                                {% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}
                                    {{ transportTranslations[item.vehicle.meta_title][item.lang].capacity }}
                                {% else %}
                                    {{ item.vehicle.capacity }}
                                {% endif %}
                            </p>
                        </div>
                    {% endif %}
                    {% if item.vehicle.payload %}
                        <div class="rounded-xl border border-[#25425E]/15 bg-[#25425E]/5 px-4 py-3">
                            <p class="text-xs uppercase tracking-wide text-[#25425E]/80 font-semibold">{{ 'transport.payload' | t(item.lang) }}</p>
                            <p class="text-base font-semibold text-[#25425E] mt-1">
                                {% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}
                                    {{ transportTranslations[item.vehicle.meta_title][item.lang].payload }}
                                {% else %}
                                    {{ item.vehicle.payload }}
                                {% endif %}
                            </p>
                        </div>
                    {% endif %}
                </div>

                <a href="{{ '/kontakti/' | langUrl(item.lang) }}" class="w-full inline-flex items-center justify-center rounded-full bg-[#25425E] text-white px-8 py-3 text-sm font-semibold uppercase tracking-wide shadow hover:shadow-lg transition-all duration-200">{{ 'transportDetail.requestTransport' | t(item.lang) }}</a>
            </div>
        </div>
    </div>
</section>

{% if item.vehicle.long_description %}
<section class="py-10">
    <div class="max-w-7xl w-full mx-auto px-4">
        <div class="rounded-3xl bg-white shadow-md border border-[#25425E]/10 p-6 md:p-10">
            <h2 class="text-2xl md:text-3xl font-bold text-[#25425E] mb-4">{{ 'transportDetail.description' | t(item.lang) }}</h2>
            <p class="text-primary-deepsea leading-relaxed text-base md:text-lg">
                {% if transportTranslations[item.vehicle.meta_title] and transportTranslations[item.vehicle.meta_title][item.lang] %}
                    {{ transportTranslations[item.vehicle.meta_title][item.lang].longDescription }}
                {% else %}
                    {{ item.vehicle.long_description }}
                {% endif %}
            </p>
        </div>
    </div>
</section>
{% endif %}

{% if item.vehicle.monitoring and item.vehicle.monitoring.length > 0 %}
<section class="py-10">
    <div class="max-w-7xl w-full mx-auto px-4">
        <div class="rounded-3xl bg-white border border-[#25425E]/10 p-6 md:p-8 shadow-md">
            <h2 class="text-2xl font-bold text-[#25425E] mb-4">{{ 'transportDetail.monitoring' | t(item.lang) }}</h2>
            <ul class="space-y-3 text-base text-primary-deepsea leading-relaxed">
                {% for monitoringItem in item.vehicle.monitoring %}
                    <li class="flex items-start gap-3">
                        <span class="w-2 h-2 mt-2 rounded-full bg-[#25425E]"></span>
                        <span>{{ monitoringItem }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</section>
{% endif %}

{% if item.vehicle.ideal_loads and item.vehicle.ideal_loads.length > 0 %}
<section class="py-10">
    <div class="max-w-7xl w-full mx-auto px-4">
        <div class="rounded-3xl bg-white border border-[#25425E]/10 p-6 md:p-8 shadow-md">
            <h2 class="text-2xl md:text-3xl font-bold text-[#25425E] mb-4">{{ 'transportDetail.suitableFor' | t(item.lang) }}</h2>
            <div class="flex flex-wrap gap-3">
                {% for load in item.vehicle.ideal_loads %}
                    <span class="px-4 py-2 rounded-full bg-[#25425E]/10 text-[#25425E] text-sm font-semibold">{{ load }}</span>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% endif %}

{% if relatedProducts and relatedProducts.length > 0 %}
<section class="py-4 md:py-12">
    <div class="max-w-7xl w-full mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-primary-blue mb-8">{{ 'transportDetail.otherVehicles' | t(item.lang) }}</h2>
        <div class="pb-2 flex overflow-x-auto sm:grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:justify-items-center sm:overflow-visible scrollbar-hide">
            {% for relatedItem in relatedProducts %}
                <div class="relative flex-shrink-0 sm:flex-shrink flex flex-col bg-white rounded-3xl shadow-md overflow-hidden w-full max-w-[280px] sm:max-w-[300px]">
                    <!-- Diagonal Color Block - Absolute to card -->
                    <div
                        class="absolute top-0 left-0 w-full"
                        style="background-color: {{ relatedItem.serviceCardColor or '#D8E8DB' }}; clip-path: polygon(0 0, 100% 0, 100% 45%, 0 85%); height: 200px;"
                    ></div>
                    
                    <div
                        class="absolute top-0 left-0 w-full"
                        style="background-color: #4F4F6C; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 0); height: 200px;"
                    ></div>
                    
                    <!-- Image Container - Full Width, Fixed Height -->
                    <div class="relative h-48 w-full overflow-hidden">
                        <!-- Vehicle Graphic -->
                        {% if relatedItem.transportCardGraphic %}
                            <div class="relative z-10 h-full flex items-center justify-center pt-4">
                                <img
                                    src="{{ relatedItem.transportCardGraphic | url }}"
                                    alt="{% if transportTranslations[relatedItem.meta_title] and transportTranslations[relatedItem.meta_title][item.lang] %}{{ transportTranslations[relatedItem.meta_title][item.lang].title }}{% else %}{{ relatedItem.title }}{% endif %}"
                                    class="w-[80%] max-h-[140px] object-contain"
                                >
                            </div>
                        {% elif relatedItem.images and relatedItem.images[0] %}
                            <div class="relative z-10 h-full flex items-center justify-center pt-4">
                                <img
                                    src="{{ relatedItem.images[0] | url }}"
                                    alt="{% if transportTranslations[relatedItem.meta_title] and transportTranslations[relatedItem.meta_title][item.lang] %}{{ transportTranslations[relatedItem.meta_title][item.lang].title }}{% else %}{{ relatedItem.title }}{% endif %}"
                                    class="w-[80%] max-h-[140px] object-contain"
                                >
                            </div>
                        {% endif %}
                    </div>
                    
                    <!-- Text Content Container - With Padding -->
                    <div class="px-4 py-4 flex flex-col gap-3 flex-1">
                        <h3 class="text-lg font-semibold text-primary-blue leading-snug">
                            {% if transportTranslations[relatedItem.meta_title] and transportTranslations[relatedItem.meta_title][item.lang] %}
                                {{ transportTranslations[relatedItem.meta_title][item.lang].title }}
                            {% else %}
                                {{ relatedItem.title }}
                            {% endif %}
                        </h3>
                        <p class="text-sm text-primary-deepsea leading-relaxed">
                            {{ relatedItem.shortDescription or relatedItem.short_description }}
                        </p>
                        
                        <div class="flex flex-col gap-2 text-sm">
                            {% if relatedItem.temperature_range %}
                                <div class="flex items-center justify-between gap-2 bg-[#25425E]/5 rounded-2xl px-3 py-2">
                                    <span class="font-semibold text-[#25425E]">{{ 'transport.temperature' | t(item.lang) }}</span>
                                    <span>
                                        {% if transportTranslations[relatedItem.meta_title] and transportTranslations[relatedItem.meta_title][item.lang] %}
                                            {{ transportTranslations[relatedItem.meta_title][item.lang].temperature_range }}
                                        {% else %}
                                            {{ relatedItem.temperature_range }}
                                        {% endif %}
                                    </span>
                                </div>
                            {% endif %}
                            {% if relatedItem.capacity %}
                                <div class="flex items-center justify-between gap-2 bg-[#25425E]/5 rounded-2xl px-3 py-2">
                                    <span class="font-semibold text-[#25425E]">{{ 'transport.capacity' | t(item.lang) }}</span>
                                    <span>
                                        {% if transportTranslations[relatedItem.meta_title] and transportTranslations[relatedItem.meta_title][item.lang] %}
                                            {{ transportTranslations[relatedItem.meta_title][item.lang].capacity }}
                                        {% else %}
                                            {{ relatedItem.capacity }}
                                        {% endif %}
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="w-full flex justify-end mt-2">
                            <a
                                href="{{ ('/transport/' ~ relatedItem.meta_title ~ '/') | langUrl(item.lang) }}"
                                class="inline-flex items-center gap-2 rounded-full bg-primary-blue text-white px-5 py-2 text-sm font-semibold shadow-md hover:shadow-lg transition-all duration-200"
                            >
                                {{ 'transport.viewMore' | t(item.lang) }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<script src="{{ '/assets/js/product-carousel.js' | url }}"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const mainImage = document.getElementById('vehicle-main-image');
        const thumbnails = document.querySelectorAll('.vehicle-thumbnail');

        thumbnails.forEach((thumb) => {
            thumb.addEventListener('click', () => {
                const newSrc = thumb.getAttribute('data-image-src');
                if (!newSrc || !mainImage) {
                    return;
                }

                mainImage.classList.add('opacity-0');
                setTimeout(() => {
                    mainImage.setAttribute('src', newSrc);
                    mainImage.classList.remove('opacity-0');
                    mainImage.classList.add('opacity-100');
                    setTimeout(() => mainImage.classList.remove('opacity-100'), 300);
                }, 150);
            });
        });
    });
</script>
