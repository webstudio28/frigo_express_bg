---
layout: base.njk
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{% if lang == 'en' %}/en/za-nas/{% else %}/za-nas/{% endif %}"
eleventyComputed:
  title: "{{ 'about.title' | t(lang) }}"
  description: "Frigo Express BG – надежден партньор в хладилната логистика"
---

<section class="py-4 md:py-12">
    <div class="max-w-7xl w-full mx-auto px-4">
        <div class="grid gap-10 md:grid-cols-2 md:items-center">
            <div class="space-y-6">
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#25425E]">{{ 'about.title' | t(lang) }}</h1>
                <p class="text-primary-deepsea leading-relaxed">
                    {{ 'about.mission' | t(lang) }}
                </p>
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="rounded-3xl bg-[#25425E]/5 border border-[#25425E]/10 px-5 py-4">
                        <h2 class="text-lg font-semibold text-[#25425E]">{{ 'about.feature1.title' | t(lang) }}</h2>
                        <p class="text-sm text-primary-deepsea mt-1">{{ 'about.feature1.text' | t(lang) }}</p>
                    </div>
                    <div class="rounded-3xl bg-[#25425E]/5 border border-[#25425E]/10 px-5 py-4">
                        <h2 class="text-lg font-semibold text-[#25425E]">{{ 'about.feature2.title' | t(lang) }}</h2>
                        <p class="text-sm text-primary-deepsea mt-1">{{ 'about.feature2.text' | t(lang) }}</p>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2 max-w-md mx-auto ">
                <div class="aspect-square overflow-hidden rounded-3xl shadow-lg">
                    <img src="{{ '/assets/images/about1.jpg' | url }}" alt="Frigo Express BG" class="w-full h-full object-cover">
                </div>
                <div class="aspect-square overflow-hidden rounded-3xl shadow-lg">
                    <img src="{{ '/assets/images/about2.jpg' | url }}" alt="Frigo Express BG" class="w-full h-full object-cover">
                </div>
                <div class="aspect-square overflow-hidden rounded-3xl shadow-lg">
                    <img src="{{ '/assets/images/about3.jpg' | url }}" alt="Frigo Express BG" class="w-full h-full object-cover">
                </div>
                <div class="aspect-square overflow-hidden rounded-3xl shadow-lg">
                    <img src="{{ '/assets/images/about4.jpg' | url }}" alt="Frigo Express BG" class="w-full h-full object-cover">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Additional Paragraphs Section -->
<section class="py-4 md:py-12">
    <div class="max-w-7xl w-full mx-auto px-4">
        <div class="flex flex-col gap-6">
            <div class="bg-white rounded-3xl shadow-md p-6 md:p-8">
                <p class="text-primary-deepsea leading-relaxed">
                    {{ 'about.paragraph1' | t(lang) }}
                </p>
            </div>
            <div class="bg-white rounded-3xl shadow-md p-6 md:p-8">
                <p class="text-primary-deepsea leading-relaxed">
                    {{ 'about.paragraph2' | t(lang) }}
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Specialization Section -->
<section class="py-4 md:py-12">
    <div class="max-w-7xl w-full mx-auto px-4 flex flex-col justify-center items-center gap-8 md:gap-12">
        <!-- Header -->
        <div class="w-full text-left">
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-primary-blue mb-4">
                {{ 'about.specialization.title' | t(lang) }}
            </h2>
            <p class="text-medium md:text-lg text-primary-deepsea max-w-5xl leading-relaxed">
                {{ 'about.specialization.description' | t(lang) }}
            </p>
        </div>

        <!-- Features Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full">
            <!-- Feature 1 -->
            <div class="bg-white rounded-xl shadow-md p-4 flex flex-col items-start gap-3">
                <img src="{{ '/assets/images/temperature-feature.png' | url }}" alt="{{ 'about.specialization.feature1' | t(lang) }}" class="h-8 flex-shrink-0">
                <h3 class="text-md font-bold text-secondary-blue">{{ 'about.specialization.feature1' | t(lang) }}</h3>
            </div>
            <!-- Feature 2 -->
            <div class="bg-white rounded-xl shadow-md p-4 flex flex-col items-start gap-3">
                <img src="{{ '/assets/images/earth.png' | url }}" alt="{{ 'about.specialization.feature2' | t(lang) }}" class="h-8 flex-shrink-0">
                <h3 class="text-md font-bold text-secondary-blue">{{ 'about.specialization.feature2' | t(lang) }}</h3>
            </div>
            <!-- Feature 3 -->
            <div class="bg-white rounded-xl shadow-md p-4 flex flex-col items-start gap-3">
                <img src="{{ '/assets/images/deadline.png' | url }}" alt="{{ 'about.specialization.feature3' | t(lang) }}" class="h-8 flex-shrink-0">
                <h3 class="text-md font-bold text-secondary-blue">{{ 'about.specialization.feature3' | t(lang) }}</h3>
            </div>
            <!-- Feature 4 -->
            <div class="bg-white rounded-xl shadow-md p-4 flex flex-col items-start gap-3">
                <img src="{{ '/assets/images/track.png' | url }}" alt="{{ 'about.specialization.feature4' | t(lang) }}" class="h-8 flex-shrink-0">
                <h3 class="text-md font-bold text-secondary-blue">{{ 'about.specialization.feature4' | t(lang) }}</h3>
            </div>
        </div>
    </div>
</section>

<section class="py-4 md:py-12">
                    <div class="max-w-7xl mx-auto px-4">
                        <div class="relative h-[600px] md:h-[400px] w-full flex flex-col md:flex-row justify-evenly items-center gap-12 p-8 overflow-hidden rounded-3xl">

                            <div class="-z-10 absolute top-0 left-0 w-full h-full flex items-center justify-center">
                                <img src="{{ '/assets/images/home-cta.png' | url }}" alt="CTA Image" class="w-full h-full object-cover" style="filter: brightness(0.3);">
                            </div>

                            
                            <div class="cta-left-side w-full sm-w-[50%] flex flex-col justify-center items-center sm:items-center text-center md:text-left">

                                <h2 class="text-white text-3xl md:text-4xl lg:text-5xl font-semibold">
                                    {{ 'home.cta.title' | t(lang) }}
                                </h2>
                                <p class="text-white text-sm font-light">
                                    {{ 'home.cta.description' | t(lang) }}
                                </p>

                            </div>

                            <div class="w-full sm-w-[50%] cta-right-side ">

                                <div class="p-8 home-cta-buttons-ct bg-white/80 rounded-3xl flex flex-col gap-4 sm:flexcol">

                                    <p class="text-primary-volcanic text-sm font-semibold">{{ 'home.cta.subtitle' | t(lang) }}</p>
                                    <div class="flex flex-col sm:flex-row gap-4">

                                        <a href="tel:+359895552692" class="text-white flex items-center justify-center gap-2 btn-primary w-full text-center rounded-3xl">
                                            {{ 'home.cta.callUs' | t(lang) }}
                                        </a>

                                        <a href="{{ '/kontakti/' | langUrl(lang) }}" class="flex items-center justify-center gap-2 btn-secondary hover:scale-105 transition-all duration-300 w-full text-center rounded-3xl">
                                            {{ 'home.cta.contacts' | t(lang) }}
                                        </a>

                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </section>


