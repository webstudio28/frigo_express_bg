        <script>
            // Language switcher - preserves current page path
            function switchLanguage(targetLang) {
                const currentPath = window.location.pathname;
                let newPath = currentPath;
                
                // Remove /en/ prefix if present
                if (newPath.startsWith('/en/')) {
                    newPath = newPath.substring(3);
                } else if (newPath === '/en') {
                    newPath = '/';
                }
                
                // Add /en/ prefix for English
                if (targetLang === 'en') {
                    if (newPath === '/') {
                        newPath = '/en/';
                    } else {
                        newPath = '/en' + newPath;
                    }
                }
                
                // Ensure trailing slash for consistency (or remove based on your preference)
                window.location.href = newPath;
            }
            
            // Drag-to-scroll for horizontal lists
            (function () {
                const containers = document.querySelectorAll('.drag-scroll');
                containers.forEach((el) => {
                    let isDown = false;
                    let startX = 0;
                    let scrollLeftStart = 0;

                    const onDown = (clientX) => {
                        isDown = true;
                        startX = clientX;
                        scrollLeftStart = el.scrollLeft;
                        el
                            .classList
                            .add('dragging');
                    };
                    const onMove = (clientX) => {
                        if (!isDown) 
                            return;
                        const dx = clientX - startX;
                        el.scrollLeft = scrollLeftStart - dx;
                    };
                    const onUp = () => {
                        isDown = false;
                        el
                            .classList
                            .remove('dragging');
                    };

                    // Mouse events
                    el.addEventListener('mousedown', (e) => {
                        // left button only
                        if (e.button !== 0) 
                            return;
                        onDown(e.clientX);
                        e.preventDefault();
                    });
                    window.addEventListener('mousemove', (e) => onMove(e.clientX));
                    window.addEventListener('mouseup', onUp);

                    // Touch events
                    el.addEventListener('touchstart', (e) => onDown(e.touches[0].clientX), {passive: true});
                    window.addEventListener('touchmove', (e) => onMove(e.touches[0].clientX), {passive: true});
                    window.addEventListener('touchend', onUp);
                });
            })();

